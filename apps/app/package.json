{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev --port 3000",
    "prisma:generate": "prisma generate --config=./prisma.config.ts",
    "build": "prisma generate --config=./prisma.config.ts && next build",
    "start": "next start",
    "typecheck": "prisma generate --config=./prisma.config.ts && tsc --noEmit --emitDeclarationOnly false",
    "test": "prisma generate --config=./prisma.config.ts && vitest run",
    "validate": "node scripts/validate-challenges.mjs",
    "lint:mati": "node scripts/lint-mati.mjs"
  },
  "dependencies": {
    "@mastra/core": "^1.0.4",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@prisma/driver-adapter-utils": "^7.4.2",
    "@repo/ai": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "^8.5.8",
    "prisma": "^7.4.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
