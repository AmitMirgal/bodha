# Public Supabase config (safe for the browser; RLS protects private data)
# Required. Browser-visible.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only Prisma URLs. Never prefix with NEXT_PUBLIC_.
# Encode reserved password characters (example: p@ss → p%40ss). A literal '@' in
# the password is rejected at startup; it is not a reason to enable anonymous auth.
# Transaction-mode pooler (port 6543). Runtime adapter adds pgbouncer=true if missing.
# Required at runtime. Server-only.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:URL_ENCODED_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler (port 5432) for Prisma CLI / generate / db pull only.
# prisma.config.ts reads DIRECT_URL. Schema changes are supabase/migrations/*.sql.
# Required for migrate/db pull; optional for generate (placeholder). Server-only.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT:URL_ENCODED_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"

# Optional. Interactive transaction wait / body timeout (defaults 15000 / 20000). Server-only.
# MATI_PRISMA_TX_MAX_WAIT_MS="15000"
# MATI_PRISMA_TX_TIMEOUT_MS="20000"
# Optional. pg Pool first-connection timeout and size (defaults 10000 / 5). Server-only.
# MATI_PG_CONNECTION_TIMEOUT_MS="10000"
# MATI_PG_POOL_MAX="5"

# Server-only encryption key for BYOK credentials (32 bytes as 64 hex chars). Required to store keys.
MATI_CREDENTIALS_ENCRYPTION_KEY=""

# Comma-separated hosts allowed for OpenAI-compatible base URLs. Required for BYOK. Server-only.
MATI_ALLOWED_LLM_HOSTS="api.openai.com,openrouter.ai"

# Opt-in HTTP for operator-approved public hosts (self-hosted). Private IPs stay blocked. Server-only.
MATI_ALLOW_HTTP_LLM="false"

# Optional operator default (used only when the user has no saved key). Server-only.
MATI_OPERATOR_LLM_PROVIDER=""
MATI_OPERATOR_LLM_MODEL=""
MATI_OPERATOR_LLM_BASE_URL=""
MATI_OPERATOR_LLM_API_KEY=""
# Operator default is unused unless the user has no saved key. Runtime still probes tools.
MATI_OPERATOR_LLM_TOOLS="unknown"

# Daily progress day-bucket timezone. Optional. Server-only.
MATI_PROGRESS_TIMEZONE="UTC"

# Legacy BODHA_* names are still read if the matching MATI_* value is unset.
