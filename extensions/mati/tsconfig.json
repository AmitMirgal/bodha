{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"types": ["node"],
		"rootDir": "src"
	},
	"include": ["src/**/*.ts"]
}
