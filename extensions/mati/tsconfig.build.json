{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"esModuleInterop": true,
		"module": "CommonJS",
		"moduleResolution": "node",
		"outDir": "dist",
		"rootDir": "src",
		"declaration": false,
		"sourceMap": false
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts"]
}
