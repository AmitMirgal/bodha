# Public Supabase config (safe for the browser; RLS protects private data)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only Prisma URLs. Never prefix with NEXT_PUBLIC_.
# Encode reserved password characters (example: p@ss → p%40ss). A literal '@' in
# the password is rejected at startup; it is not a reason to enable anonymous auth.
# Transaction-mode pooler (port 6543). Runtime adapter adds pgbouncer=true if missing.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:URL_ENCODED_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler (port 5432) for Prisma CLI / generate / db pull only.
# prisma.config.ts reads DIRECT_URL. Schema changes are supabase/migrations/*.sql.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT:URL_ENCODED_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"
# Optional. Interactive transaction wait / body timeout (defaults 15000 / 20000).
# BODHA_PRISMA_TX_MAX_WAIT_MS="15000"
# BODHA_PRISMA_TX_TIMEOUT_MS="20000"
# Optional. pg Pool first-connection timeout and size (defaults 10000 / 5).
# BODHA_PG_CONNECTION_TIMEOUT_MS="10000"
# BODHA_PG_POOL_MAX="5"

# Server-only encryption key for BYOK credentials (32 bytes as 64 hex chars)
BODHA_CREDENTIALS_ENCRYPTION_KEY=""

# Comma-separated hosts allowed for OpenAI-compatible base URLs
BODHA_ALLOWED_LLM_HOSTS="api.openai.com,openrouter.ai"

# Opt-in HTTP for operator-approved public hosts (self-hosted). Private IPs stay blocked.
BODHA_ALLOW_HTTP_LLM="false"

# Optional operator default (used only when the user has no saved key)
BODHA_OPERATOR_LLM_PROVIDER=""
BODHA_OPERATOR_LLM_MODEL=""
BODHA_OPERATOR_LLM_BASE_URL=""
BODHA_OPERATOR_LLM_API_KEY=""
# Operator default is unused unless the user has no saved key. Runtime still probes tools.
BODHA_OPERATOR_LLM_TOOLS="unknown"

# Daily progress day-bucket timezone
BODHA_PROGRESS_TIMEZONE="UTC"
