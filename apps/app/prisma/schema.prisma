// Prisma mapping of the Mati product schema. Authoritative history is
// apps/app/prisma/migrations (applied with `prisma migrate deploy`).
// Roles, FORCE RLS, policies, grants, and SQL functions live in those
// migration.sql files because Prisma schema cannot express them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  devices             Device[]
  pairingCodes        PairingCode[]
  cursorAdminSettings CursorAdminSettings?
  captureTasks        CaptureTask[]
  captureEvents       CaptureEvent[]
  captureUsage        CaptureUsage[]
  captureReports      CaptureReport[]

  @@map("profiles")
}

model LlmSettings {
  userId          String   @id @map("user_id") @db.Uuid
  provider        String
  model           String
  /// Unused by Mati. Official provider endpoints live in adapters.
  baseUrl         String?  @map("base_url")
  encryptedApiKey String   @map("encrypted_api_key")
  encryptionIv    String   @map("encryption_iv")
  encryptionTag   String   @map("encryption_tag")
  keyFingerprint  String   @map("key_fingerprint")
  capabilities    Json     @default("{\"tools\": \"unknown\", \"streaming\": \"unknown\", \"usageReporting\": \"unknown\", \"structuredOutput\": \"unknown\"}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("llm_settings")
}

model Session {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  exerciseId  String    @map("exercise_id")
  status      String
  files       Json      @default("{}")
  timezone    String    @default("UTC")
  consentAt   DateTime? @map("consent_at") @db.Timestamptz(6)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  saveError   String?   @map("save_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  snapshots ExerciseSnapshot[]
  evidence  EvidenceEvent[]
  messages  Message[]
  testRuns  TestRun[]
  reports   Report[]
  usage     UsageRecord[]

  @@unique([id, userId], map: "sessions_id_user_id_key")
  @@index([userId, createdAt(sort: Desc)], map: "sessions_user_created_idx")
  @@index([userId, status], map: "sessions_user_status_idx")
  @@map("sessions")
}

model ExerciseSnapshot {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  exerciseId    String   @map("exercise_id")
  contentHash   String   @map("content_hash")
  specMarkdown  String   @map("spec_markdown")
  testsSource   String   @map("tests_source")
  starter       Json
  meta          Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session        Session   @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Cascade)
  testRuns       TestRun[] @relation("TestRunSnapshotSession")
  testRunsByUser TestRun[] @relation("TestRunSnapshotUser")
  reports        Report[]  @relation("ReportSnapshotSession")
  reportsByUser  Report[]  @relation("ReportSnapshotUser")

  @@unique([sessionId])
  @@unique([id, userId])
  @@unique([id, sessionId])
  @@map("exercise_snapshots")
}

model EvidenceEvent {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId        String   @map("session_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  seq              BigInt   @default(autoincrement())
  kind             String
  source           String
  observationType  String   @map("observation_type")
  payload          Json
  idempotencyKey   String   @map("idempotency_key")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session  Session   @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Cascade)
  messages Message[]
  testRuns TestRun[]

  @@unique([sessionId, idempotencyKey])
  @@unique([sessionId, seq])
  @@unique([id, sessionId])
  @@unique([id, userId])
  @@index([sessionId, seq], map: "evidence_session_seq_idx")
  @@map("evidence_events")
}

model Message {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  evidenceId String?  @map("evidence_id") @db.Uuid
  role       String
  content    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session  Session        @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Cascade)
  evidence EvidenceEvent? @relation(fields: [evidenceId, sessionId], references: [id, sessionId], onDelete: SetNull)

  @@index([sessionId, createdAt], map: "messages_session_created_idx")
  @@map("messages")
}

model TestRun {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String   @map("session_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  snapshotId        String   @map("snapshot_id") @db.Uuid
  evidenceId        String?  @map("evidence_id") @db.Uuid
  codeRevisionHash  String   @map("code_revision_hash")
  results           Json
  fatal             String?
  provenance        String   @default("browser_harness")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session        Session           @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Cascade)
  snapshot       ExerciseSnapshot  @relation("TestRunSnapshotSession", fields: [snapshotId, sessionId], references: [id, sessionId])
  snapshotByUser ExerciseSnapshot  @relation("TestRunSnapshotUser", fields: [snapshotId, userId], references: [id, userId])
  evidence       EvidenceEvent?    @relation(fields: [evidenceId, sessionId], references: [id, sessionId])

  @@index([sessionId, createdAt], map: "test_runs_session_idx")
  @@map("test_runs")
}

model Report {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  snapshotId String   @map("snapshot_id") @db.Uuid
  version    Int      @default(1)
  status     String
  body       Json?
  error      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session        Session          @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Cascade)
  snapshot       ExerciseSnapshot @relation("ReportSnapshotSession", fields: [snapshotId, sessionId], references: [id, sessionId])
  snapshotByUser ExerciseSnapshot @relation("ReportSnapshotUser", fields: [snapshotId, userId], references: [id, userId])

  @@unique([sessionId, version])
  @@index([sessionId, version], map: "reports_session_idx")
  @@map("reports")
}

model UsageRecord {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId             String   @map("session_id") @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  operationId           String   @map("operation_id")
  agentRole             String   @map("agent_role")
  inputTokens           BigInt?  @map("input_tokens")
  outputTokens          BigInt?  @map("output_tokens")
  cachedTokens          BigInt?  @map("cached_tokens")
  cachedIncludedInInput Boolean? @map("cached_included_in_input")
  coverage              String
  native                Json?
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([sessionId, operationId])
  @@map("usage_records")
}

model Device {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash     String   @unique @map("token_hash")
  claimedUserId String?  @map("claimed_user_id") @db.Uuid
  consent       Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claimedUser Profile?           @relation(fields: [claimedUserId], references: [id], onDelete: SetNull)
  tasks       CaptureTask[]
  events      CaptureEvent[]
  usage       CaptureUsage[]
  claimTokens DeviceClaimToken[]

  @@index([createdAt], map: "devices_unclaimed_created_idx")
  @@map("devices")
}

model CursorAdminSettings {
  userId          String   @id @map("user_id") @db.Uuid
  encryptedApiKey String   @map("encrypted_api_key")
  encryptionIv    String   @map("encryption_iv")
  encryptionTag   String   @map("encryption_tag")
  keyFingerprint  String   @map("key_fingerprint")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cursor_admin_settings")
}

model PairingCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([codeHash], map: "pairing_codes_hash_idx")
  @@map("pairing_codes")
}

model CaptureTask {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId      String    @map("device_id") @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  editor        String
  editorTaskId  String    @map("editor_task_id")
  status        String
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  workspaceHash String    @map("workspace_hash")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  device  Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user    Profile?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  events  CaptureEvent[]
  usage   CaptureUsage[]
  reports CaptureReport[]

  @@unique([deviceId, editor, editorTaskId])
  @@index([deviceId, startedAt(sort: Desc)], map: "capture_tasks_device_idx")
  @@map("capture_tasks")
}

model CaptureEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  deviceId       String   @map("device_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  kind           String
  payload        Json
  idempotencyKey String   @map("idempotency_key")
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  device Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  task   CaptureTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   Profile?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([deviceId, idempotencyKey])
  @@index([taskId, occurredAt], map: "capture_events_task_idx")
  @@map("capture_events")
}

model CaptureUsage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  deviceId        String   @map("device_id") @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  operationId     String   @map("operation_id")
  provenance      String
  source          String
  inputTokens     BigInt?  @map("input_tokens")
  outputTokens    BigInt?  @map("output_tokens")
  cachedTokens    BigInt?  @map("cached_tokens")
  reasoningTokens BigInt?  @map("reasoning_tokens")
  model           String?
  native          Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  device Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  task   CaptureTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   Profile?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([taskId, operationId])
  @@index([taskId], map: "capture_usage_task_idx")
  @@map("capture_usage")
}

model DeviceClaimToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId   String    @map("device_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId], map: "device_claim_tokens_device_idx")
  @@map("device_claim_tokens")
}

model CaptureReport {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  version   Int      @default(1)
  status    String
  body      Json?
  error     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task CaptureTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, version])
  @@index([taskId, version], map: "capture_reports_task_idx")
  @@map("capture_reports")
}
